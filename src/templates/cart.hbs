<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>{{page_title}}</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="assets/css/style-{{lang}}.min.css">
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"
    integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo"
    crossorigin="anonymous"></script>
  <script src="assets/js/lib.min.js"></script>
</head>

<body>






  {{>_header}}


  <section class="cart-page py-5 ">
    <div class="container-fluid">
      <div class="col-12">
        <nav aria-label="breadcrumb" class="container-fluid">
          <ol class="breadcrumb bg-light my-4">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item"><a href="#">library</a></li>
            <li class="breadcrumb-item active" aria-current="page">shopping cart</li>
          </ol>
        </nav>
      </div>
      <div class="row">
        <div class="  col-xl-9">


            <div class="bg-white shadow-lg p-3 p-xl-5">
                <div class="cart-items ">
                  {{#each s.productsList}}
                  <div class="cart-item d-flex align-items-center justify-content-between">
                    <picture>
                      <img src="assets/img/products/{{@index}}.jpg" alt="">
                    </picture>
                    <a href="#" class="cart-item-title">{{title}}</a>
                    <p class="cart-item-info"><span>Bolt Sweatshirt</span>
                      <span>Size: M</span>
                      <span>Color: Blue</span>
                      <span>Gender: Women</span>
                    </p>
                    <div class="cart-item-price">
                      <span class="current-price"> <b>$</b><ins>39.00</ins></span>
                    </div>
                    <form class="cart-item-quantity m-l-5 d-flex" data-price="39" data-instock="60">
                      <input type="hidden" value="39" name="total">
                      <input type="button" class="minus btn btn-lg" value="-">
                      <input type="number" class="qty form-control form-control-lg" value="1" readonly>
                      <input type="button" class="plus btn btn-lg" value="+">
                    </form>
                    <div class="cart-item-total">
                      <h4>{{../local.total}}</h4>
                      <span class="total-price" dir="ltr"> <b>$</b><ins>39.00</ins></span>
                    </div>

                    <div class="remove-cart-item">
                      <button class="btn btn-outline-danger remove-item-btn">
                        <i class="fa fa-times"></i>
                      </button>
                    </div>

                  </div>
                  {{/each}}
                </div>

                  <div class="update-cart p-3 p-xl-5 mt-5">
                  <div class="row  justify-content-between">
                    <div class="col-md-5 col-lg-4 col-xl-3 form-col">
                        <form action="">
                          <div class="form-group d-flex">
                                <input type="text" class="form-control form-control-lg" id="CouponCode" placeholder="{{local.coupon}}"
                                  aria-describedby="CouponCodeHelpBlock">
                                  <button type="submit" class="btn btn-dark mx-3  btn-lg">{{local.apply}}</button>
                          </div>
                          <small id="CouponCodeHelpBlock" class="form-text text-muted d-block">
                            {{local.enter_coupon}}
                          </small>
                        </form>



                    </div>
                    <div class="col col-md-auto">
                      <button class="btn btn-dark btn-update btn-lg">{{local.update_cart}}</button>
                    </div>
                  </div>
                  </div>
            </div>




        </div>
        <div class="col-xl-3">
          <div class="bg-white shadow-lg p-3 p-xl-5 cart-total col-lg-6 col-xl-12">
              <h2 class="mb-3">{{local.cart_total}}</h2>
              <div class="table-responsive">
                  <table class="table fixed-layout ">
                    <tr>
                      <td><strong>{{local.cart_total}}</strong></td>
                      <td><span class="cart_sub_total" dir="ltr"><b>$</b> <span>106.8</span> </span></td>
                    </tr>
                    <tr>
                      <td><strong>{{local.coupon}}</strong></td>
                      <td><span class="ct-coupon">-20%</span></td>
                    </tr>
                    <tr>
                      <td><strong>{{local.total}}</strong></td>
                        <td><span class="cart-total-price" dir="ltr"><b>$</b> <strong>106.8</strong> </span></td>
                    </tr>
                  </table>
              </div>
              <div class="mt-4">
                <button class="btn-block btn btn-success btn-lg ">{{local.proceed_to_checkout}}</button>
              </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {{>_footer}}




  <script src="assets/js/cart.min.js"></script>
  <script src="assets/js/scripts.min.js"></script>
</body>

</html>