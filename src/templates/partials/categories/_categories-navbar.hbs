<section class="categories-navigation">
  <div class="container-fluid">
    <div class="px-3 d-md-none my-4 text-center">
      <button class="btn btn-outline-dark btn-block btn-lg" type="button" data-toggle="collapse" data-target="#collapseNav"
        aria-expanded="true" aria-controls="collapseNav">
        <i class="fa fa-cubes"></i>{{local.categories}}
      </button>
    </div>
      <div class="collapse show" id="collapseNav">
          <div class="row no-gutters shadow mb-5">
            {{#each c.categories}}
            <div class="col-md-4 col-lg-3 col-xl-2">
              <a href="#" class="cate_nav_item">
                <picture>
                  <img src="assets/img/c/{{i}}" alt="">
                </picture>
                <span>
                  {{t}}
                </span>
              </a>
            </div>
            {{/each}}
          </div>
      </div>
  </div>
</section>