<section class="position-relative cp-featured">
  <div class="container-fluid">
    <div class="cp_background d-flex justify-content-center align-items-center">
      <img src="assets/img/{{c.bg}}" alt="">
    </div>

    <div class="px-lg-5 cp-content pt-5">
      <h2 class="cp-search-title"><span>{{c.t}}</span></h2>

      {{#each c.s}}
      <div class="row fs-row my-3">
        <div class="col-md-5 col-lg-4">
          <div class="si-card bg-white shadow">
            <picture class="si-mask" {{#if video}} data-video="{{video}}"  data-poster="assets/img/{{img}}"{{/if}}>
              <img src="assets/img/{{img}}" alt="">
            </picture>
            <div class="si-info d-flex align-items-center">
              <img src="assets/img/{{avatar}}" alt="" class="avatar d-md-none d-xl-block">
              <span>
                <h4 class="si-title"><a href="#">{{name}}</a></h4>
                <img src="assets/img/{{flag}}" alt="{{factory.country}}" width="25" class="flag">
                <small>{{country}} | {{age}}</small>
                <div>
                  {{#each icons}}
                  <img src="assets/img/{{this}}" alt="" width="12">
                  {{/each}}
                </div>
              </span>
            </div>
          </div>
        </div>
        <div class="col-md-7 col-lg-8">
           <div class="owl-carousel fsp-carousel" data-xl-items="4" data-lg-items="2" data-md-items="2" data-margin="20" >
            {{#each products}}

            <div class="fsp-item shadow bg-white">
              <picture {{#if video}} data-video="{{video}}"  data-poster="assets/img/product-{{@index}}.jpg" {{/if}}>
                <img src="assets/img/product-{{@index}}.jpg" alt="" class="no-owl">
              </picture>
              <div class="fsp-info">
                <a href="#" class="h4">{{title}}</a>
                <p class="fsp-price">
                  <b class="text-danger">{{min_price}}</b>
                  <small><s>{{price}}</s></small>
                  <span class="badge badge-danger">{{discount}}</span> <br>
                  <strong>{{../../local.min_order}}</strong>: {{min}}
                </p>
              </div>
            </div>
            {{/each}}
           </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>


<!-- Modal -->
<div class="modal fade" id="VideosModal" tabindex="-1" role="dialog"
  aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
    <div class="modal-content">
     <button type="button" class="btn btn-dark btn-close-video" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
      <div class="modal-body">
        <video width="100%" controls>
          Your browser does not support HTML5 video.
        </video>
      </div>
    </div>
  </div>
</div>