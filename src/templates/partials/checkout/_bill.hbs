<section class="my-3 my-xl-5  bill-section  p-3 p-xl-5">

  <div class="d-lg-none ">
    <button class="order-summary-toggle" type="button" data-toggle="collapse" data-target="#order-summary"
      aria-expanded="false" aria-controls="order-summary">
      <span class="order-summary-toggle-inner">
        <svg width="20" height="19" xmlns="http://www.w3.org/2000/svg" class="order-summary-toggle-icon">
          <path
            d="M17.178 13.088H5.453c-.454 0-.91-.364-.91-.818L3.727 1.818H0V0h4.544c.455 0 .91.364.91.818l.09 1.272h13.45c.274 0 .547.09.73.364.18.182.27.454.18.727l-1.817 9.18c-.09.455-.455.728-.91.728zM6.27 11.27h10.09l1.454-7.362H5.634l.637 7.362zm.092 7.715c1.004 0 1.818-.813 1.818-1.817s-.814-1.818-1.818-1.818-1.818.814-1.818 1.818.814 1.817 1.818 1.817zm9.18 0c1.004 0 1.817-.813 1.817-1.817s-.814-1.818-1.818-1.818-1.818.814-1.818 1.818.814 1.817 1.818 1.817z">
          </path>
        </svg>

        <span class="show"> {{local.show_order_summary}} <i class="fa fa-angle-down"></i></span>
        <span class="hide">{{local.hide_order_summary}} <i class="fa fa-angle-up"></i></span>
      </span>
      <span class="order-summary-total">
        <span>$2,199.00</span>
      </span>
    </button>
  </div>
  <div class="collapse show order-summary" id="order-summary">
    <div class="table-responsive">
      <table class="table table-summary">
        {{#each_up_to s.productsList 2}}
            <tr>
              <td>
                <div class="product-thumbnail">
                  <picture>
                    <img src="assets/img/products/1.jpg" alt="">
                  </picture>
                  <span class="badge badge-pill badge-dark">2</span>
                </div>
              </td>
              <td class="product-title">
                <span >
                  {{title}}
                </span>
              </td>
              <td class="total-price">
                <span dir="ltr"> <b>$</b><ins>78.00</ins></span>
              </td>
            </tr>
        {{/each_up_to}}
      </table>

      <table class="table table-total">
          <tr>
            <th>{{local.cart_total}}</th>
            <td dir="ltr"><b>$</b> <span>106.8</span></td>
          </tr>
          <tr>
            <th>{{local.total}}</th>
            <td class="totalprice" dir="ltr"><b>$</b> <span>106.8</span></td>
          </tr>
      </table>
    </div>
    <div>

    </div>
  </div>
</section>