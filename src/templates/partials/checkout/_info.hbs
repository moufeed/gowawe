<div class="my-3 my-xl-5 bg-white shadow-lg p-4 p-md-5 mx-xl-5">

  <div class="mx-xl-5">
    <div class="ct-h f-d-c d-flex justify-content-between">
      <h2 class="text-capitalize">{{local.contact_information}}</h2>
      <p>
        {{local.have_account}}
        <a href="#">{{local.login}}</a>
      </p>
    </div>

    <form action="" class="form checkout-information-form">
      <div class="form-group">
        <label for="">{{local.email}}</label>
        <input type="email" name="" id="" class="form-control form-control-lg rounded-0">
      </div>
      <div class="custom-control custom-checkbox">
        <input type="checkbox" class="custom-control-input" id="keep_me_up">
        <label class="custom-control-label" for="keep_me_up">{{local.keep_me_up}}</label>
      </div>
      <div class="mt-5">
        <h3 class="text-capitalize">{{local.shipping_address}}</h3>
        <div class="form-row form-group">
          <div class="col-md-6">
            <label for="">{{local.first_name}}</label>
            <input type="text" class="form-control form-control-lg rounded-0">
          </div>
          <div class="col-md-6">
            <label for="">{{local.last_name}}</label>
            <input type="text" class="form-control form-control-lg rounded-0">
          </div>
        </div>
        <div class="form-group">
          <label for="">{{local.address}}</label>
          <input type="text" name="" id="" class="form-control form-control-lg rounded-0">
        </div>
        <div class="form-group">
          <label for="">{{local.apartment}}</label>
          <input type="text" name="" id="" class="form-control form-control-lg rounded-0">
        </div>
        <div class="form-group">
          <label for="">{{local.city}}</label>
          <input type="text" name="" id="" class="form-control form-control-lg rounded-0">
        </div>

        <div class="form-row form-group">
          <div class="col-md-6">
            <label for="">{{local.country}}</label>
            <select name="" id="" class="form-control form-control-lg rounded-0 select">
              {{#each countries}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          </div>
          <div class="col-md-6">
            <label for="">{{local.postal_code}}</label>
            <input type="text" name="" id="" class="form-control form-control-lg rounded-0">
          </div>
        </div>


        <div class="form-group  f-d-c d-flex justify-content-between mt-5 btns-bar">
          <a href="#" class="btn btn-link text-dark text-capitalize">
            <i class="fa fa-angle-left"></i>&nbsp;
            {{local.back_to_cart}}
          </a>

          <button type="submit" class="btn btn-lg btn-dark ">
            {{local.continue_to_payment}}
          </button>
        </div>
      </div>
    </form>
  </div>

</div>