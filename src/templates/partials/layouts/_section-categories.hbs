<section class="categories-section container-fluid my-3">
  <div class="py-5 px-3 shadow-sm gray-bg">
    <div class="row row-cols-3">
      <div class="col col-xl-3 col-lg-4">
          <h3 class="categories-title mb-3">
            {{title}}
          </h3>
        <nav class="nav flex-column categories-list">
           {{#each categories}}
             <a class="nav-link" href="#">{{this}}</a>
           {{/each}}
        </nav>
      </div>
      <div class="col col-xl-7">
        <div class="owl-carousel" data-singleitem="true">
            {{#each slider}}
            <div class="item">
              <img src="assets/img/{{this}}" alt="">
            </div>
            {{/each}}
        </div>
        <div class="row flex-wrap justify-content-around row-cols-3">
              {{#each featured}}
                <div class="col">
                    <div class="card shadow-sm p-4" style="background-image:url('assets/img/{{img}}')">
                      <p class="h3">{{txt}}</p>
                    </div>
                </div>
              {{/each}}
        </div>
      </div>
      <div class="col-xl-2 col-lg-3">
        <div class="bg-white shadow-sm py-3 px-2">
        <h4>{{local.you_may_like}}</h4>
        <div>
          <ul class="list-unstyled">
            {{#each likes}}
            <li class="itm">
              <a href="#">
                <img src="assets/img/{{img}}" class="" alt="">
                <div class="itm-body">
                  <strong>{{title}}</strong>
                  {{txt}}
                </div>
              </a>
            </li>
            {{/each}}
          </ul>
        </div>
        </div>
      </div>
    </div>
  </div>
</section>