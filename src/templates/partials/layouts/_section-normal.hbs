<section class="home-section my-4" id="{{id}}">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="row no-gutters section-header justify-content-between"
          style="background-image: url('assets/img/{{background}}')">
          <div class="col-12 col-sm-auto section-title">
            <h2>{{title}}</h2>
            <p>{{brief}}</p>
          </div>
          <div class="col-12 col-sm-auto">
            <nav class="section-links nav">
              {{#if subLinks}}
              {{#each subLinks}}
              <a href="{{this.link}}" class="nav-link">{{this.text}}</a>
              {{/each}}
              {{/if}}
            </nav>
            <p class="section-brief mt-1">{{brief}}</p>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-4">

      </div>
      <div class="col-lg-9 col-md-8">

        <div class="main-carousel">
          {{#each products_slider}}
          <div class="row">

            {{#each this.products}}
            {{!-- start product --}}

            <div class="col-md-4 h-prod-item">
              <div class="h-prod-header">
                <span>
                  {{#if this.img.length}}
                  <img src="./assets/img/{{this.img}}" alt="" class="pro-img">
                  {{/if}}
                  {{#if this.images.length}}
                  <ul class="list-unstyled prod-imgs owl-carousel" data-singleitem="true">
                    {{#each this.images}}
                    <li class="item">
                      <img src="./assets/img/{{this}}" alt="">
                    </li>
                    {{/each}}
                  </ul>
                  {{/if}}
                </span>
                <span>
                  <h5>{{local.price}}</h5>
                </span>
              </div>
            </div>
            <div class="col-md-4 h-prod-item">
              <div class="h-prod-header">
                <span>
                  {{#if this.img.length}}
                  <img src="./assets/img/{{this.img}}" alt="" class="pro-img">
                  {{/if}}
                  {{#if this.images.length}}
                  <ul class="list-unstyled prod-imgs owl-carousel" data-singleitem="true">
                    {{#each this.images}}
                    <li class="item">
                      <img src="./assets/img/{{this}}" alt="">
                    </li>
                    {{/each}}
                  </ul>
                  {{/if}}
                </span>
                <span>
                  <h5>{{local.price}}</h5>
                  <p class="h-prod-price">
                    <b class="text-danger">{{min_price}}</b> /{{local.pieces}} <br>
                    <small><s>{{price}}</s></small>
                    <span class="badge badge-danger">{{discount}}</span>
                  </p>
                  <p class="h-prod-order">
                    {{local.min_order}} : {{min}}
                  </p>

                  {{#if colors.length}}
                      <p class="h-prod-colors">
                        <div>
                          <strong>{{local.colors}}</strong>
                          {{#each colors}}
                            <span style="background-color: {{this}};"></span>
                          {{/each}}
                        </div>
                      </p>
                  {{/if}}
                </span>
              </div>
            </div>
            <div class="col-md-4 h-prod-item">
              <div class="h-prod-header">
                <span>
                  {{#if this.img.length}}
                  <img src="./assets/img/{{this.img}}" alt="" class="pro-img">
                  {{/if}}
                  {{#if this.images.length}}
                  <ul class="list-unstyled prod-imgs owl-carousel" data-singleitem="true">
                    {{#each this.images}}
                    <li class="item">
                      <img src="./assets/img/{{this}}" alt="">
                    </li>
                    {{/each}}
                  </ul>
                  {{/if}}
                </span>
                <span>
                  <h5>{{local.price}}</h5>
                </span>
              </div>
            </div>
            {{!-- end product --}}
            {{/each}}
          </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>
</section>