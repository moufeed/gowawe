<section class="home-section my-5 container-fluid" id="{{id}}">
  <div class="bg-white shadow-sm">
    <div class="row align-items-stretch">
      <div class="col-12">
        <div class="row no-gutters section-header justify-content-between "
          style="background-image: url('assets/img/{{background}}')">
          <div class="col-12 col-sm-auto section-title">
            <h2>{{title}}</h2>
            <p>{{brief}}</p>
          </div>
          <div class="col-12 col-sm-auto">
            <nav class="section-links nav">
              {{#if subLinks}}
              {{#each subLinks}}
              <a href="{{this.link}}" class="nav-link">{{this.text}}</a>
              {{/each}}
              {{/if}}
            </nav>
            <p class="section-brief mt-1">{{brief}}</p>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-4 d-sm-none d-none d-lg-block">
        <button type="button" class="btn btn-danger position-absolute shopping-btn">{{local.shopping}}</button>
        <div class="featured-slider owl-carousel " data-rtl="{{isRtl dir}}" data-singleitem="true" data-nav="true">
          {{#each featured_slider.slides}}
          {{!--
          style="background-image:url(assets/img/{{img}});"
          --}}
          <div class="item item-bg" >
            {{!-- <img src="assets/img/{{img}}" alt="" class="d-xl-none"> --}}
            <div class="mask d-flex justify-content-center align-items-center">
             <img src="assets/img/{{img}}" alt="" class="">
            </div>
          </div>
          {{/each}}
        </div>
      </div>
      <div class="col-lg-9 col-md-12 py-4">
        <div class="main-carousel owl-carousel" data-singleitem="true" data-nav="true"  data-rtl="{{isRtl dir}}">
          {{#each products_slider}}
          <div class="row">
            {{#each this.products}}
            {{!-- start product --}}
            <div class="col-md-6  col-xl-4">
              <div class="h-prod-item card">
                <div class="h-prod-header">
                  <span>

                    {{#if this.img.length}}
                    <img src="./assets/img/{{this.img}}" alt="" class="pro-img">
                    {{/if}}
                    {{#if this.images.length}}
                    <ul class="list-unstyled prod-imgs owl-carousel" data-singleitem="true" data-dots="true" data-rtl="{{isRtl ../../dir}}"
                      data-mousedrag="false" data-touchdrag="false">
                      {{#each this.images}}
                      <li class="item">
                        <img src="./assets/img/{{this}}" alt="">
                      </li>
                      {{/each}}
                    </ul>
                    {{/if}}
                  </span>

                  <span class="pt-25 h-info">
                    <h5>{{../../local.price}}</h5>
                    <p class="h-prod-price">
                      <b class="text-danger">{{min_price}}</b> /{{../../local.pieces}} <br>
                      <small><s>{{price}}</s></small>
                      <span class="badge badge-danger">{{discount}}</span>
                    </p>
                    <p class="h-prod-order">
                      <strong>{{../../local.min_order}}</strong>: {{min}}
                    </p>

                    {{#if colors.length}}

                    <div class="h-prod-colors">
                      <strong class="d-block mb-2">{{../../local.colors}} :</strong>
                      {{#each colors}}
                      <span style="background-color: {{this}};"></span>
                      {{/each}}
                    </div>
                    {{/if}}
                  </span>
                </div>
                <h4 class="h-prod-title card-title"><a href="#">
                    {{title}}
                  </a></h4>
                <footer class="h-prod-footer">
                  <div class="factory d-flex align-items-center px-3 my-2">
                    <img src="assets/img/{{factory.avatar}}" alt="" width="55" class="rounded no-owl">
                    <span class="mx-2">
                      <strong class="d-block">{{factory.name}}</strong>
                      <img src="assets/img/{{factory.flag}}" alt="{{factory.country}}" width="25" class="no-owl">
                      <small>{{factory.country}} | {{factory.age}}</small>
                    </span>
                  </div>
                  <div class="actions-bar p-3">
                      {{#each actions}}
                        <a href="{{link}}" class="btn btn-outline-dark"
                        {{#if tooltip}}
                          data-toggle="tooltip" data-placement="top" title="{{tooltip}}"
                        {{/if}}
                         >
                          {{#if ico}}
                              <i class="{{ico}}"></i>
                          {{/if}}

                          {{#if txt}}
                            <span>{{txt}}</span>
                          {{/if}}
                        </a>
                      {{/each}}
                  </div>
                </footer>
              </div>
            </div>

            {{!-- end product --}}
            {{/each}}
          </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>
</section>