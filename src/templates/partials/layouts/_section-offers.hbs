<section class="offers-section container-fluid my-3">
  <div class="bg-white py-5 px-3 shadow-sm">
  <div class ="row row-cols-1 row-cols-md-2">
     {{#each data}}
      <div class="col">
        <div class="d-flex justify-content-between mb-2">
            <h5>{{title}} <small class="text-black-50">({{count}})</small></h5>
            <a href="#" class="btn btn-link text-dark">{{../local.view_more}}</a>
        </div>
        <div class="table-responsive">
          <table class="table table-striped table-bordered">
           {{#each data}}
                <tr>
                  <td>
                    <img src="assets/img/{{flag}}" alt="" class="icon">
                     <span>{{name}}</span>
                  </td>
                  <td>
                    <a href="#" class="text-dark">{{txt}}</a>
                  </td>
                  <td width="100" class="text-center">
                    <span class="text-danger">{{date}}</span>
                  </td>
                </tr>
           {{/each}}
          </table>
        </div>
      </div>
    {{/each}}
  </div>
  </div>
</section>
