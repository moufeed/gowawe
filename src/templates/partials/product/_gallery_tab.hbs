<section class="products-gallery-tab my-5">
  <div class="container-fluid">
    <div class="row se-gallery">
      {{#each s.productsList}}

      <div class="col-12 col-md-6 col-xl-4 ">
        <div class="fsp-item   bg-white m-b-30">
          {{#if video}}
          <picture data-video="{{video}}" data-poster="assets/img/product-{{@index}}.jpg">
            <img src="assets/img/products/{{@index}}.jpg" alt="">
          </picture>
          {{else}}
          <a href="assets/img/products/{{@index}}.jpg">
            <picture>
              <img src="assets/img/products/{{@index}}.jpg" alt="">
            </picture>
            </a>
          {{/if}}

        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>


<!-- Modal -->
<div class="modal fade" id="VideosModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
    <div class="modal-content">
      <button type="button" class="btn btn-dark btn-close-video" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
      <div class="modal-body">
        <video width="100%" controls>
          Your browser does not support HTML5 video.
        </video>
      </div>
    </div>
  </div>
</div>