<section class="related-products-tab my-5 pt-5 shadow-lg px-3 bg-white">
      <h3>Related Products</h3>
    <div class="owl-carousel" data-dir="{{isRtl dir}}" data-xl-items="4" data-margin="30">
      {{#each s.productsList}}
<div class="fsp-item  m-b-30">
  <picture>
    <a href="#"> <img src="assets/img/products/{{@index}}.jpg" alt="" class="no-owl"> </a>
  </picture>
  <div class="fsp-info">
    <a href="#" class="h4">{{title}}</a>
    <p class="fsp-price">
      <span class="d-flex justify-content-between">
        <b class="text-danger">{{min_price}}</b>
        <span>
          <small><s>{{price}}</s></small>
          <span class="badge badge-danger">{{discount}}</span>
        </span>
      </span>
      <strong>{{../local.min_order}}</strong>: {{min}}
    </p>
  </div>
</div>
      {{/each}}

  </div>
</section>