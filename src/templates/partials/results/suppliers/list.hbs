
<div class="list-results">

  {{#each sp.suppliers}}
  <div class="supplier-card shadow px-5 py-4 mb-4 bg-white rounded d-flex justify-content-between align-items-start flex-wrap">
    <div class="supplier-info col-12 col-md-12 col-xl-7">
      <h3 class="mb-4"><a href="#">{{name}}</a></h3>
      <div class="meta">
         {{#each features}}
              <span>
                <img src="assets/img/{{ico}}" alt="">
                {{txt}}
              </span>
         {{/each}}
      </div>
      <ul class="list-unstyled">
        <li>
          <strong>{{../local.business_type}} :</strong>
          <span>{{type}}</span>
        </li>
        <li>
          <strong>{{../local.mainProducts}} :</strong>
          <span>{{products}}</span>
        </li>
        <li>
          <strong>{{../local.certification}} :</strong>
          <span>{{certification}}</span>
        </li>
        <li>
          <strong>{{../local.city_province}} :</strong>
          <span>{{address}}</span>
        </li>
      </ul>
      <div class="actions mt-4">
          <a href="#" class="btn bg-warning text-white shadow-sm">
            <i class="fa fa-envelope" aria-hidden="true"></i>
            {{../local.contact_now}}</a>
          <button class="btn btn-link mx-4">
              <i class="fa fa-commenting fa-2x" aria-hidden="true"></i>
              {{../local.chat_with_supplier}}
          </button>
      </div>
      <a href="#" class="text-muted btn mt-2 inquiry-btn">
        <i class="fa fa-cart-arrow-down " aria-hidden="true"></i>
        {{../local.inquiry_basket}}
      </a>
      <hr class="d-xl-none" />
    </div>
    <div class="supplier-images col-12 col-md-12 col-xl-5">
      {{#each images}}
          <span class="rounded d-inline-block">
              <img src="assets/img/{{this}}" alt="">
          </span>

      {{/each}}
    </div>
  </div>
  {{/each}}

  <nav aria-label="Page navigation example">
    <ul class="pagination">
      <li class="page-item">
        <a class="page-link" href="#" aria-label="Previous">
          <span aria-hidden="true">&laquo;</span>
        </a>
      </li>
      <li class="page-item"><a class="page-link" href="#">1</a></li>
      <li class="page-item"><a class="page-link" href="#">2</a></li>
      <li class="page-item"><a class="page-link" href="#">3</a></li>
      <li class="page-item">
        <a class="page-link" href="#" aria-label="Next">
          <span aria-hidden="true">&raquo;</span>
        </a>
      </li>
    </ul>
  </nav>
</div>
