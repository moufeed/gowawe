<section class="seller-products-tab my-5">
  <div class="container-fluid">
    <div class="col-12 col-md-6 col-xl-5 se-contact-header">
      <h3><span>{{local.get_in_touch}}</span></h3>
      <p>{{lorem}}</p>
    </div>
      <div class="bg-white shadow-lg ">
        <div class="row">

          <div class="col-md-8 col-xl-9  se-contact-form">
            <div class="p-5">

              <form action="" class="form p-xl-5">
                <h3>{{local.send_us_message}}</h3>
                  <div class="form-row form-group">
                    <div class="col-12 col-md-6">
                      <label for="">{{local.name}}</label>
                      <input type="text" class="form-control form-control-lg" placeholder="{{local.name}}">
                    </div>
                    <div class="col-12 col-md-6">
                      <label for="">{{local.Mobile}}</label>
                      <input type="tel" class="form-control form-control-lg" placeholder="{{local.Mobile}}">
                    </div>
                  </div>
                  <div class="form-row form-group">
                    <div class="col-12 col-md-6 ">
                      <label for="">{{local.email}}</label>
                      <input type="email" class="form-control form-control-lg" placeholder="{{local.email}}">
                    </div>
                    <div class="col-12 col-md-6">
                      <label for="">{{local.subject}}</label>
                      <input type="tel" class="form-control form-control-lg" placeholder="{{local.subject}}">
                    </div>
                  </div>
                  <div class="form-group mt-3">
                    <label for="">{{local.message}}</label>
                    <textarea name="" id="" cols="30" rows="5" class="form-control" placeholder="{{local.message}}"></textarea>
                  </div>
                  <div class="form-group d-flex justify-content-end">
                    <button type="submit" class="btn btn-info p-x-25 btn-lg"> <i class="fa fa-send-o"></i> {{local.send}}</button>
                  </div>
              </form>

            </div>
          </div>
          <div class="col-md-4 col-xl-3 se-contact-info">
            <div class="d-flex flex-column justify-content-start align-items-center pd">
              <h3><span>Contact information</span></h3>
              <ul class="list-unstyled links-list">
                  <li>
                    <i class="fa fa-phone"></i>
                    <a href="#" dir="ltr">095863258779</a>
                  </li>
                  <li>
                      <i class="fa fa-envelope"></i>
                      <a href="#">mail@to.com</a>
                  </li>
              </ul>

              <ul class="social-list">
                <li>
                  <a href="#"><i class="fa fa-facebook"></i></a>
                  <a href="#"><i class="fa fa-twitter"></i></a>
                  <a href="#"><i class="fa fa-youtube"></i></a>
                </li>
              </ul>
            </div>
          </div>
        </div>

      </div>
  </div>
</section>
