

<section class="seller-products-tab py-5 px-xl-5">
    <div class="container-fluid">
        <div class="row">
          <div class="col-md-4 col-xl-3">
              {{> seller/partials/_categories}}
          </div>
          <div class="col-md-8 col-xl-9">
            <ul class="nav nav-tabs pro-tabs" id="proTab" role="tablist">
              <li class="nav-item">
                <a class="nav-link active" id="Products-tab" data-toggle="tab" href="#Products" role="tab" aria-controls="Products"
                  aria-selected="true">All Products</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" id="Customization-tab" data-toggle="tab" href="#Customization" role="tab" aria-controls="Customization"
                  aria-selected="false">Customization</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" id="Ship-tab" data-toggle="tab" href="#Ship" role="tab" aria-controls="Ship"
                  aria-selected="false">Ready to Ship</a>
              </li>
            </ul>
            <div class="tab-content pro-tabs-content" id="pContent">
              <div class="tab-pane fade show active " id="Products" role="tabpanel" aria-labelledby="Products-tab">
                {{>seller/partials/_productsList}}
              </div>
              <div class="tab-pane fade " id="Customization" role="tabpanel" aria-labelledby="Customization-tab">
                {{>seller/partials/_productsList}}
              </div>
              <div class="tab-pane fade " id="Ship" role="tabpanel" aria-labelledby="Ship-tab">
                {{>seller/partials/_productsList}}
              </div>
            </div>

          </div>
        </div>
    </div>
</section>




<!-- Modal -->
<div class="modal fade" id="VideosModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
    <div class="modal-content">
      <button type="button" class="btn btn-dark btn-close-video" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
      <div class="modal-body">
        <video width="100%" controls>
          Your browser does not support HTML5 video.
        </video>
      </div>
    </div>
  </div>
</div>