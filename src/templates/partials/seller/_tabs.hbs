<div class="container-fluid">
  <section class="section-tabs bg-white shadow-lg py-5 p-4">
    <div class="row">
        <div class="col-lg-8 col-xl-8">


  <ul class="nav nav-tabs nav-line" id="se-Tab" role="tablist">
            {{#each s.tabs}}
            <li class="nav-item">
              <a class="nav-link {{#is @index 0}}active{{/is}}" id="tab-{{@index}}" data-toggle="tab" href="#se-tab-{{@index}}" role="tab" aria-controls="se-tab-{{@index}}"
                aria-selected="{{#is @index 0}}true{{else}}false{{/is}}">{{this}}</a>
            </li>
            {{/each}}

          </ul>
          <div class="tab-content" id="se-TabContent">
            <div class="tab-pane fade show active" id="se-tab-0" role="tabpanel" aria-labelledby="tab-0">
              {{>seller/tabs/_tab-0}}
            </div>
            <div class="tab-pane fade" id="se-tab-1" role="tabpanel" aria-labelledby="tab-1">
              {{>seller/tabs/_tab-1}}
            </div>
            <div class="tab-pane fade" id="se-tab-2" role="tabpanel" aria-labelledby="tab-2">
              {{>seller/tabs/_tab-2}}
            </div>
            <div class="tab-pane fade" id="se-tab-3" role="tabpanel" aria-labelledby="tab-3">
              {{>seller/tabs/_tab-3}}
            </div>
            <div class="tab-pane fade" id="se-tab-4" role="tabpanel" aria-labelledby="tab-4">
              {{>seller/tabs/_tab-4}}
            </div>
          </div>

        </div>
        <div class="col-lg-4 col-xl-4">
            <div class="owl-carousel se-pro-slider" data-rtl="{{isRtl dir}}" data-singleItem = "true" data-dots="true">
                <div class="se-pro-item d-flex justify-content-center align-items-center">
                    <img src="assets/img/alphacolor-r6RCPk1X91c-unsplash.jpg"  class="no-owl" alt="">
                </div>
                <div class="se-pro-item d-flex justify-content-center align-items-center">
                  <iframe src="https://www.youtube.com/embed/cE5PGI8-osc" frameborder="0"
                    allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
  </section>
</div>
