<a href="#" class="top_picks d-flex align-items-center m-b-20">
  <i class="fa fa-shopping-bag" aria-hidden="true"></i>
  <strong>{{local.top_picks}}</strong>
</a>

<div class="bg-white shadow  py-md-5 p-3">
  <h3 class="m-b-25 px-3 text-capitalize">
    <strong>{{local.product_categories}}</strong>
  </h3>
  <hr>
  <ul class="list-unstyled categoriesList seller-categories" id="categoriesList">

    {{#each sp.categories}}
    <li>
      <a class="" data-toggle="collapse" href="#category-{{@index}}" role="button" aria-expanded="false"
        aria-controls="category-{{@index}}">
        <i class="fa fa-angle-right" aria-hidden="true"></i>
        <span>{{category}}</span>
      </a>
      <ul class="list-unstyled sub-list collapse" aria-labelledby="category-{{@index}}" id="category-{{@index}}"
        data-parent="#categoriesList">
        <li>
          <a href="#">{{../local.all}}</a>
        </li>
        {{#each list}}
        <li>
          <a href="#">{{this}}</a>
        </li>
        {{/each}}
      </ul>
    </li>
    {{/each}}
  </ul>
</div>

<div class="bg-white shadow  my-5 py-md-5 p-3">
  <div class="product-recommend-small"  data-slick='{"slidesToShow": 4, "slidesToScroll": 4 ,"arrows": false, "vertical" : true}'>
    {{#each s.productsList}}
    <div class="d-flex product-itm">
      <picture  class="d-flex justify-content-center align-items-center" {{#if video}} data-video="{{video}}" data-poster="assets/img/product-{{@index}}.jpg" {{/if}} >
        <img src="assets/img/products/{{@index}}.jpg" alt="" class="no-owl" >
      </picture>
      <div class="product-itm-body">
        <h5 class="mt-0 mb-1 product-itm-title"><a href="#">{{title}}</a></h5>
        <p class="m-0">
          <span>{{min_price}}</span> <small>/ {{../local.piece}}</small>
        </p>
        <p class="m-0">
          <span>{{min}}</span> <small>({{../local.min_order}})</small>
        </p>
      </div>




    </div>
    {{/each}}
  </div>

  <div class="btn-group mx-4 slick-buttons-group mt-3" role="group">
    <button type="button" class="btn btn-outline-dark px-4 slick-up"> <i class="fa fa-angle-up"></i></button>
    <button type="button" class="btn btn-outline-dark px-4 slick-down"><i class="fa fa-angle-down"></i></button>

  </div>

</div>