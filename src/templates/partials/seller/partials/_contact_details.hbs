<div class="contact-details-row bg-white shadow-lg p-4 my-5 {{class}}">
  <div class="row justify-content-between">
    <div class="col-12  col-md-7 col-xl-9">
      <div class="se-details">
        <h3><span>{{local.contact_details}}</span></h3>
        <ul class="list-unstyled d-flex se-c-list">
          <li>
            <strong> <i class="fa fa-mobile"></i> {{local.Mobile}}</strong>
            <span>8745745695</span>
          </li>
          <li>
            <strong> <i class="fa fa-map-marker"></i> {{local.address}} </strong>
            <span>Rajasthan, India</span>
          </li>
          <li>
            <strong> <i class="fa fa-envelope-o"></i> {{local.email}}</strong>
            <a href="#">miss.@gmail.com</a>
          </li>
          <li>
            <strong><i class="fa fa-globe"></i> {{local.website}}</strong>
            <a href="#">www.gowawe.com</a>
          </li>

          <li>
            <strong><i class="fa fa-globe"></i> {{local.find_us}}</strong>
            <nav class="se-social-links">
              <a href="#"> <i class="fa fa-facebook"></i></a>
              <a href="#"> <i class="fa fa-twitter"></i></a>
              <a href="#"> <i class="fa fa-youtube"></i></a>
            </nav>
          </li>
        </ul>
        <hr>
        <div class="se-des mt-4">
          <h3><span>{{local.description}}</span></h3>
          <div class="se-d-content">{{lorem}}</div>
        </div>
      </div>

    </div>
    <div class="col-12 col-md-5 col-xl-3">
      <div class="se-map">
        <iframe frameborder="0" scrolling="no" marginheight="0" marginwidth="0"
          src="https://maps.google.com/maps?hl=en&q=&ie=UTF8&t=roadmap&z=15&iwloc=B&output=embed"></iframe>
      </div>
    </div>
  </div>
</div>