<div class="bg-white mb-4 shadow-lg  p-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="title ">{{local.send_us_message}}</h3>
  </div>
  <form action="" class="p-4" validate-form>
      <div class="form-group row">
        <label for="" class="col-sm-3 col-lg-2  col-form-label">To</label>
        <div class="col-sm-9 col-lg-10">
          <input type="text" class="form-control" id="" readonly value="Lorem, ipsum.">
        </div>
      </div>
      <div class="form-group row">
        <label for="" class="col-sm-3 col-lg-2 col-form-label">Message</label>
        <div class="col-sm-9 col-lg-10">
           <textarea name="" id="" cols="30" rows="6" class="form-control" required></textarea>
        </div>
      </div>
      <div class="form-group">
          <div class="col-sm-9 col-lg-10 offset-sm-3 offset-lg-2">
              <button type="submit" class="btn btn-success p-x-25">{{local.send}}</button>
          </div>
      </div>
  </form>
</div>
