<div class="bg-white shadow-lg p-3 mb-4">
  <div class="row">
    <div class="col-12 col-lg-6">
      <div class="owl-carousel se-pro-slider" data-rtl="{{isRtl dir}}" data-singleItem="true" data-dots="true">
        <div class="se-pro-item d-flex justify-content-center align-items-center">
          <img src="assets/img/alphacolor-r6RCPk1X91c-unsplash.jpg" class="no-owl" alt="">
        </div>
        <div class="se-pro-item d-flex justify-content-center align-items-center">
          <iframe src="https://www.youtube.com/embed/cE5PGI8-osc" frameborder="0"
            allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-6">

      <p class="seller-profile-intro mt-2">
         {{lorem}}
         {{lorem}}
      </p>
      <span class="company-card d-flex justify-content-start">
        <a href="#" class="rate">
          <span class="total-score">3.5</span>
          <div class="total-desc">
            <div class="review-num">67 Reviews</div>
          </div>
        </a>
        <ul class="transaction-detail list-unstyled">
          <li>
            <strong class="transaction-detail-title">Transaction level</strong>
            <svg class="icbu-icon-svg" width="16" height="16" viewBox="0 0 64 64">
              <use xlink:href="#diamond"></use>
            </svg>
          </li>
          <li>
            <strong class="transaction-detail-title">201 Transactions</strong>
            <span class="transaction-detail-content">90,000+</span>
          </li>
          <li>
            <strong class="transaction-detail-title">Response Time</strong>
            <span class="transaction-detail-content"> 24h</span>
          </li>
          <li>
            <strong class="transaction-detail-title">Response Rate</strong>
            <span class="transaction-detail-content">96.6%</span>
          </li>
        </ul>

</span>

    </div>
  </div>


  <div class="table-responsive gradient">
    <table class="table table-borderless table-hover fixed-table tab-table">
      <tr>
        <td><strong>{{local.nameofyourstore}}</strong></td>
        <td> store name</td>
      </tr>
      <tr>
        <td><strong>{{local.meta_description}}</strong></td>
        <td>Lorem ipsum dolor sit amet consectetur, adipisicing elit. Fuga ipsum quasi nam, cum velit rem!</td>
      </tr>
      <tr>
        <td><strong>{{local.meta_keyword}}</strong></td>
        <td>Lorem ipsum dolor sit amet.</td>
      </tr>
      <tr>
        <td><strong>{{local.businesscategory}}</strong></td>
        <td>Home & Kitchen, Feed, Nuts Kernels, Animal Accessories, Air Fryer, Alfalfa Hay, Almonds, Apparel</td>
      </tr>
      <tr>
        <td><strong>{{local.natureofbusiness}}</strong></td>
        <td>Seller</td>
      </tr>
      <tr>
        <td><strong>{{local.yearcompanyregistered}}</strong></td>
        <td>2010</td>
      </tr>
      <tr>
        <td><strong>{{local.ownershiptype}}</strong></td>
        <td>Individual (Sole Proprietorship)</td>
      </tr>
      <tr>
        <td><strong>{{local.certification}}</strong></td>
        <td></td>
      </tr>
    </table>
  </div>

</div>