<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>{{page_title}}</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="assets/css/style-{{lang}}.min.css">
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"
    integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo"
    crossorigin="anonymous"></script>
  <script src="assets/js/lib.min.js"></script>
</head>

<body>

  {{>_header}}


  <section class="categories-page">
    <div class="container-fluid">
      <ul class="nav categories-tabs mt-3 mb-2" id="tap" role="tablist">
        <li class="nav-item">
          <a class="nav-link active" id="products-tab" data-toggle="tab" href="#products" role="tab"
            aria-controls="products" aria-selected="true">{{local.products}}</a>
        </li>
        <li class="nav-item">
          <a class="nav-link " id="jobs-tab" data-toggle="tab" href="#jobs" role="tab" aria-controls="jobs"
            aria-selected="false">{{local.jobs}}</a>
        </li>
        <li class="nav-item">
          <a class="nav-link " id="partner-tab" data-toggle="tab" href="#partner" role="tab" aria-controls="partner"
            aria-selected="false">{{local.project_partner}}</a>
        </li>

      </ul>
      <div class="tab-content" id="tapContent">
        <div class="tab-pane fade show active" id="products" role="tabpanel" aria-labelledby="products-tab">
          {{>products/products}}
        </div>
        <div class="tab-pane fade " id="jobs" role="tabpanel" aria-labelledby="jobs-tab">
          {{>products/jobs}}
        </div>
        <div class="tab-pane fade " id="partner" role="tabpanel" aria-labelledby="partner-tab">
          {{>products/partners}}
        </div>
      </div>
    </div>
  </section>

  {{>_footer}}


{{!--

<script src="assets/js/carousel.min.js"></script>
 --}}
  <script src="assets/js/scripts.min.js"></script>
</body>

</html>