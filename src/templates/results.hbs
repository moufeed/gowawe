<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>{{page_title}}</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="assets/css/style-{{lang}}.min.css">
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"
    integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo"
    crossorigin="anonymous"></script>
  <script src="assets/js/lib.min.js"></script>
</head>

<body>

{{_header}}

<section class="results-page">
  <div class="container-fluid">
<ul class="nav nav-tabs results-tabs mt-3 " id="tap" role="tablist">
  <li class="nav-item">
    <a class="nav-link " id="products-tab" data-toggle="tab" href="#products" role="tab" aria-controls="products"
      aria-selected="true">{{local.products}}</a>
  </li>
  <li class="nav-item">
    <a class="nav-link active" id="suppliers-tab" data-toggle="tab" href="#suppliers" role="tab" aria-controls="suppliers"
      aria-selected="false">{{local.suppliers}}</a>
  </li>

</ul>
<div class="tab-content" id="tapContent">
  <div class="tab-pane fade " id="products" role="tabpanel" aria-labelledby="products-tab">...</div>
  <div class="tab-pane fade show active" id="suppliers" role="tabpanel" aria-labelledby="suppliers-tab">

      {{>results/types}}


    <div class="row">
        <div class="col-12 col-md-4  col-xl-3">
          {{>results/filters}}
        </div>
        <div class="col-12 col-md-8  col-xl-9">
          {{>results/products-list}}
        </div>
    </div>
  </div>
</div>
  </div>
</section>
{{_footer}}
  <script src="assets/js/scripts.min.js"></script>
</body>

</html>