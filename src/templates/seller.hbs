<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>{{page_title}}</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="assets/css/style-{{lang}}.min.css">
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"
    integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo"
    crossorigin="anonymous"></script>
  <script src="assets/js/lib.min.js"></script>
</head>

<body>

  {{>_header}}

  <section class="seller-page">
    {{>seller/_header c=s.header}}

    <div class="seller-toolbar">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-9 col-xl-8 seller-nav">
            <nav>
              <div class="nav nav-tabs" id="nav-tab" role="tablist">
                {{#each s.navs}}
                <a class="nav-item nav-link {{#is @index 2 }} active {{/is}}" id="nav-{{@index}}-tab" data-toggle="tab"
                  href="#tab-{{@index}}" role="tab" aria-controls="tab-{{@index}}"
                  aria-selected="{{#is @index 2 }} true {{@else}} false {{/is}}">{{this}}</a>
                {{/each}}
              </div>
            </nav>
          </div>
          <div class="col-12 col-xl-auto seller-links">
            <nav class="contact-links">
              <a href="tel:8745745695">
                <i class="fa fa-phone"></i>
                <span dir="ltr">8745745695</span></a>
              <a href="mailto:miss.@gmail.com">
                <i class="fa fa-envelope"></i>
                miss.@gmail.com</a>
            </nav>
          </div>
        </div>
      </div>
    </div>

    <div class="tab-content" id="nav-tabContent">
      <div class="tab-pane fade" id="tab-0" role="tabpanel" aria-labelledby="tab-0-tab">
        {{>seller/_home_page}}
      </div>
      <div class="tab-pane fade" id="tab-1" role="tabpanel" aria-labelledby="tab-1-tab">
        {{>seller/_profile}}
      </div>
      <div class="tab-pane fade active show" id="tab-2" role="tabpanel" aria-labelledby="tab-2-tab">
        {{>seller/_products}}
      </div>
      <div class="tab-pane fade " id="tab-3" role="tabpanel" aria-labelledby="tab-3-tab">
        {{>seller/_classified}}
      </div>
      <div class="tab-pane fade  " id="tab-4" role="tabpanel" aria-labelledby="tab-4-tab">
        {{>seller/_feedback}}
      </div>
      <div class="tab-pane fade" id="tab-5" role="tabpanel" aria-labelledby="tab-5-tab">
        {{>seller/_contact}}
      </div>
    </div>

    {{!-- <div class="seller-tabs">
      {{>seller/_tabs}}
    </div> --}}

  </section>
  {{>_footer}}
<script src="assets/js/carousel.min.js"></script>
<script src="assets/js/validation.min.js"></script>

{{#is dir 'rtl'}}
<script src="assets/js/messages.ar.min.js"></script>
{{/is}}
<script src="assets/js/magnific.min.js"></script>
<script src="assets/js/seller.min.js"></script>
<script src="assets/js/scripts.min.js"></script>

</body>

</html>
